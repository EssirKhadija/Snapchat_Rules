NODE_ENV=test
PORT=4000
DATABASE_URL=postgresql://test:test@localhost:5432/snaprules_test
JWT_ACCESS_TOKEN_SECRET=test_access_secret_key_for_tests
JWT_REFRESH_TOKEN_SECRET=test_refresh_secret_key_for_tests
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379/1
SNAPCHAT_CLIENT_ID=test_client_id
SNAPCHAT_CLIENT_SECRET=test_client_secret
SNAPCHAT_REDIRECT_URI=http://localhost:3000/auth/callback
ENCRYPTION_KEY=test_encryption_key_32_chars_long!
SYNC_CRON_EXPRESSION=* * * * *
LOG_LEVEL=error
