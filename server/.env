# Database
DATABASE_URL="mysql://root:@localhost:3306/snaprules"
# Server
PORT=4000

# JWT
JWT_ACCESS_TOKEN_SECRET=change_me_access_secret
JWT_REFRESH_TOKEN_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Snapchat OAuth
SNAPCHAT_CLIENT_ID=your_snapchat_client_id
SNAPCHAT_CLIENT_SECRET=your_snapchat_client_secret
SNAPCHAT_REDIRECT_URI=http://localhost:4000/api/v1/snapchat/callback

# Redis (for queues)
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=change_me_encryption_key
