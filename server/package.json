    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^1.88.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "express-validator": "^6.15.0",
    "form-data": "^4.0.6",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "node-cron": "^3.0.2",
    "prisma": "^6.16.2",
    "qs": "^6.11.2",
    "redis": "^6.0.1",
