generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String             @map("password_hash")
  fullName          String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  refreshTokens     RefreshToken[]
  snapchatAccount   SnapchatAccount?
  rules             Rule[]
  ruleExecutionLogs RuleExecutionLog[]
  settings          UserSettings?

  @@map("users")
}

model SnapchatAccount {
  id                String     @id @default(uuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id])
  externalAccountId String
  organizationId    String     @default("") @map("organization_id")
  displayName       String
  accessToken       String     @db.Text
  refreshToken      String     @db.Text
  tokenExpiresAt    DateTime   @map("token_expires_at")
  status            String     @default("ACTIVE")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  campaigns         Campaign[]

  @@map("snapchat_accounts")
}

model Campaign {
  id                String          @id @default(uuid())
  snapchatAccountId String          @map("snapchat_account_id")
  externalId        String          @unique @map("external_id")
  name              String
  status            String
  objective         String?
  dailyBudget       Float?          @map("daily_budget")
  totalBudget       Float?          @map("total_budget")
  startTime         DateTime?       @map("start_time")
  endTime           DateTime?       @map("end_time")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  snapchatAccount   SnapchatAccount @relation(fields: [snapchatAccountId], references: [id], onDelete: Cascade)
  adSquads          AdSquad[]

  @@map("campaigns")
}

model AdSquad {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  externalId  String   @unique @map("external_id")
  name        String
  status      String
  dailyBudget Float?   @map("daily_budget")
  bidAmount   Float?   @map("bid_amount")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("ad_squads")
}

model Rule {
  id                String             @id @default(uuid())
  userId            String             @map("user_id")
  name              String
  description       String?
  isActive          Boolean            @default(true) @map("is_active")
  conditions        Json
  actions           Json
  checkInterval     Int                @default(60) @map("check_interval")
  lastCheckedAt     DateTime?          @map("last_checked_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation(fields: [userId], references: [id])
  ruleExecutionLogs RuleExecutionLog[]

  @@map("rules")
}

model RuleExecutionLog {
  id         String   @id @default(uuid())
  ruleId     String   @map("rule_id")
  userId     String   @map("user_id")
  status     String
  message    String?  @db.Text
  executedAt DateTime @default(now()) @map("executed_at")
  rule       Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@map("rule_execution_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")
  notificationsEnabled Boolean  @default(true) @map("notifications_enabled")
  emailNotifications   Boolean  @default(true) @map("email_notifications")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
